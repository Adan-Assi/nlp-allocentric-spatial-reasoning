# Virtual environment
.venv/
env/
venv/

# Python / OS junk
__pycache__/
*.py[cod]
*$py.class
.DS_Store
Thumbs.db
*.log

# --- ML / DATA SPECIFIC --- #

# Ignore all raw and processed data
data/raw_hf/
data/processed/

# Ignore Manhattan-specific binary data
data/manhattan/*.gpickle
data/manhattan/*.pkl

# Ignore all graph formats
data/graphs/*.gpickle
data/graphs/*.gpkg
data/graphs/*.graphml

# Ignore caches and temporary artifacts
cache/
.ipynb_checkpoints/

# Ignore Model weights and checkpoints
models/
runs/
checkpoints/

# Allow the manifest or small config files inside data
!data/graphs/manifest.json