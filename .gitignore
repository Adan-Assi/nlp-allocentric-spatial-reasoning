# Virtual environment
.venv/
env/
venv/

# Python / OS junk
__pycache__/
*.py[cod]
*$py.class
.DS_Store
Thumbs.db
*.log

# --- ML / DATA SPECIFIC --- #

# --- ML / DATA SPECIFIC --- #

# 1. Ignore all city-specific binary data
data/**/*.gpickle
data/**/*.pkl
data/**/*.gpkg
data/**/*.graphml

# 2. Ignore ALL Parquet files by default (includes city silver files)
data/**/*.parquet
*.parquet

# 3. EXCEPTIONS: Specifically allow the core Master files
!data/RVS_MASTER_GOLD_HYDRATED.parquet
!data/RVS_MASTER_SILVER_STANDARD.parquet

# 4. Ignore the raw JSON instruction files
data/**/*.json

# Exceptions: Keep our variants and small configs
!data/**/underspecified_variants.json
!data/graphs/manifest.json

# 5. Ignore any HTML files (e.g., from Jupyter exports)
*.html

# Ignore specific temporary debug artifacts
appendix_rescued_samples_v4.csv

# Ignore Jupyter notebook checkpoints and cache
.ipynb_checkpoints/
notebooks/cache/

# Slurm Log files
logs/

venv_linux/

# ---------- EXCEPTIONS: Files that take a while to generate ---------- 

# Keep city silver standard files
!data/**/manhattan_silver_standard.parquet
!data/**/philadelphia_silver_standard.parquet
!data/**/pittsburgh_silver_standard.parquet

# Keep original city instruction files (rather small, have original instructions)
!data/**/manhattan.json
!data/**/philadelphia.json
!data/**/pittsburgh.json

# Keep generated masked instruction files
!data/**/underspecified_variants.json
!data/**/underspecified_variants_labeled.json

# Keep evaluation parquet files
!reports/llm_audits/LLM_DEGRADATION_INPUT.parquet
!reports/llm_audits/LLM_DEGRADATION_RESULTS.parquet