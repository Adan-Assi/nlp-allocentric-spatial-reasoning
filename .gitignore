# Virtual environment
.venv/
env/
venv/

# Python / OS junk
__pycache__/
*.py[cod]
*$py.class
.DS_Store
Thumbs.db
*.log

# --- ML / DATA SPECIFIC --- #

# Ignore all city-specific binary data (Recursive)
data/**/*.gpickle
data/**/*.pkl
data/**/*.gpkg
data/**/*.graphml
data/**/*.parquet

# Ignore the raw JSON instruction files
data/**/*.json

# Exceptions: Keep our variants and small configs if needed
!data/**/underspecified_variants.json
!data/graphs/manifest.json

# Ignore Analysis/Temporary artifacts
all_discovered_landmarks.csv
*.html
.ipynb_checkpoints/

# Ignore any large CSVs or Parquet files in the data directory (e.g., raw data dumps)
data/manhattan/*.csv
*.parquet